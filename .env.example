# Copy to .env and fill in what you have. Everything is optional;
# missing keys just disable that source/feature.

# --- Discovery ---
GOOGLE_PLACES_API_KEY=        # Google Cloud > APIs > "Places API (New)"
SERPER_API_KEY=               # https://serper.dev (2,500 free queries)

# --- Enrichment ---
PAGESPEED_API_KEY=            # optional, raises PageSpeed quota (free)

# --- AI pitch lines (optional, --ai-pitch) ---
ANTHROPIC_API_KEY=
PITCH_MODEL=claude-opus-5-5   # cheaper option: claude-haiku-5-5

# --- Google Sheets export (optional, --gsheet) ---
GOOGLE_SHEETS_CREDENTIALS=    # path to service-account JSON
GOOGLE_SHEET_ID=              # ID or URL of a sheet shared (Editor) with the service-account email

# --- Scraping behaviour ---
PROXY_URL=                    # e.g. http://user:pass@host:port (directory scraping at volume)
CONCURRENCY=10
DIRECTORY_DELAY_MS=2500
CACHE_DAYS=14

# --- Bill protection: hard caps per run ---
MAX_PLACES_CALLS_PER_RUN=50
MAX_SERPER_CALLS_PER_RUN=50
